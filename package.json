{
  "name": "dongv-ui-system",
  "version": "1.2.1",
  "description": "Reusable desktop operations UI tokens, CSS and React components from dongV.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/tokens.css",
    "src/tokens.json",
    "compat",
    "README.md",
    "DESIGN.md",
    "PAGE-TEMPLATES.md",
    "MIGRATION.md",
    "SOURCE.md",
    "LICENSE",
    "COMPONENTS.md",
    "components.json"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "style": "./dist/components.css",
  "exports": {
    ".": "./dist/index.js",
    "./react": "./dist/index.js",
    "./tokens.css": "./src/tokens.css",
    "./tokens.json": "./src/tokens.json",
    "./components.css": "./dist/components.css",
    "./compat/youpu.css": "./compat/youpu.css"
  },
  "scripts": {
    "tokens": "node scripts/generate-tokens.mjs",
    "tokens:check": "node scripts/generate-tokens.mjs --check",
    "build:lib": "vite build",
    "build:example": "vite build --config example/vite.config.js",
    "build": "npm run build:lib && npm run build:example",
    "test": "npm run build:lib && node --test tests/*.test.mjs",
    "scan": "node scripts/check.mjs",
    "check": "npm run tokens:check && npm run manifest && npm test && npm run build:example && npm run scan && npm pack --dry-run",
    "manifest": "node scripts/generate-manifest.mjs"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20"
  },
  "devDependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.0.6"
  },
  "engines": {
    "node": ">=20"
  },
  "directories": {
    "example": "example",
    "test": "tests"
  },
  "dependencies": {
    "b-tween": "^0.3.3",
    "b-validate": "^1.5.3",
    "baseline-browser-mapping": "^2.11.18",
    "browserslist": "^4.28.8",
    "caniuse-lite": "^1.0.30001809",
    "color": "^3.2.1",
    "color-convert": "^1.9.3",
    "color-name": "^1.1.3",
    "color-string": "^1.9.1",
    "compute-scroll-into-view": "^1.0.20",
    "convert-source-map": "^2.0.0",
    "cookie": "^1.1.1",
    "csstype": "^3.2.3",
    "dayjs": "^1.11.23",
    "debug": "^4.4.3",
    "detect-node-es": "^1.1.0",
    "dom-helpers": "^5.2.1",
    "dongv-ui-system": "^1.1.1",
    "electron-to-chromium": "^1.5.412",
    "esbuild": "^0.28.2",
    "escalade": "^3.2.0",
    "fdir": "^6.5.0",
    "focus-lock": "^1.3.6",
    "gensync": "^1.0.0-beta.2",
    "is-arrayish": "^0.3.4",
    "js-tokens": "^4.0.0",
    "jsesc": "^3.1.0",
    "json5": "^2.2.3",
    "lodash": "^4.18.1",
    "loose-envify": "^1.4.0",
    "lru-cache": "^5.1.1",
    "lucide-react": "^0.468.0",
    "ms": "^2.1.3",
    "nanoid": "^3.3.18",
    "node-releases": "^2.0.53",
    "number-precision": "^1.6.0",
    "object-assign": "^4.1.1",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.5",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "playwright-core": "^1.62.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.26",
    "prop-types": "^15.8.1",
    "react-clientside-effect": "^1.2.8",
    "react-focus-lock": "^2.13.7",
    "react-is": "^18.3.1",
    "react-refresh": "^0.18.0",
    "react-router": "^7.18.2",
    "react-router-dom": "^7.18.2",
    "react-transition-group": "^4.4.5",
    "resize-observer-polyfill": "^1.5.1",
    "rollup": "^4.62.5",
    "scheduler": "^0.27.0",
    "scroll-into-view-if-needed": "^2.2.31",
    "semver": "^6.3.1",
    "set-cookie-parser": "^2.7.2",
    "shallowequal": "^1.1.0",
    "simple-swizzle": "^0.2.4",
    "source-map-js": "^1.2.1",
