    "tslib": "^2.8.1",
    "update-browserslist-db": "^1.3.1",
    "use-callback-ref": "^1.3.3",
    "use-sidecar": "^1.1.3",
    "yallist": "^3.1.1"
  },
  "keywords": [],
  "author": ""
}
