{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "dongv-ui-system",
  "version": "1.0.0",
  "sourceCommit": "8c75a16",
  "sourceDate": "2026-08-09",
  "font": {
    "family": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
    "bodySize": "13px",
    "bodyWeight": 500,
    "titleSize": "24px",
    "titleWeight": 600,
    "titleLineHeight": 1.2
  },
  "layout": {
    "pageCanvasMaxWidth": "1440px",
    "desktopMinWidth": "960px",
    "titleBarMinHeight": "45px",
    "controlHeight": "36px",
    "tabHeight": "42px",
    "tableHeaderHeight": "38px",
    "tableRowHeight": "52px",
    "tableRowHeightCompact": "44px",
    "tableRowHeightStandard": "52px",
    "tableRowHeightProduct": "74px"
  },
  "shape": {
    "controlRadius": "8px",
    "panelRadius": "12px",
    "floatingRadius": "14px"
  },
  "motion": {
    "fast": "150ms",
    "normal": "220ms",
    "slow": "300ms"
  },
  "color": {
    "brand": {
      "light": "#e1261c",
      "dark": "#ff6b61"
    },
    "brandSoft": {
      "light": "#fff3f1",
      "dark": "#3a2523"
    },
    "pageBg": {
      "light": "#f3f5f8",
      "dark": "#181b20"
    },
    "stageBg": {
      "light": "#f5f6f8",
      "dark": "#1b1f24"
    },
    "surface": {
      "light": "#ffffff",
      "dark": "#22262d"
    },
    "surfaceRaised": {
      "light": "#ffffff",
      "dark": "#282d35"
    },
    "surfaceSoft": {
      "light": "#f6f7f9",
      "dark": "#252a31"
    },
    "text": {
      "light": "#232730",
      "dark": "#e8eaee"
    },
    "textMuted": {
      "light": "#6d7684",
      "dark": "#a7afb9"
    },
    "border": {
      "light": "#e2e6ed",
      "dark": "#3a414c"
    },
    "borderStrong": {
      "light": "#cfd6e2",
      "dark": "#4c5664"
    },
    "success": {
      "light": "#257043",
      "dark": "#61ca92"
    },
    "successSoft": {
      "light": "#effaf4",
      "dark": "#1d3329"
    },
    "warning": {
      "light": "#9a6518",
      "dark": "#e5b45f"
    },
    "warningSoft": {
      "light": "#fff7e8",
      "dark": "#3b3020"
    },
    "danger": {
      "light": "#bf342c",
      "dark": "#ff746b"
    },
    "dangerSoft": {
      "light": "#fff3f1",
      "dark": "#422622"
    },
    "info": {
      "light": "#2563eb",
      "dark": "#79a7ff"
    },
    "infoSoft": {
      "light": "#eff8ff",
      "dark": "#1e3154"
    },
    "disabled": {
      "light": "#8a919c",
      "dark": "#8f98a5"
    },
    "comparisonPositive": {
      "light": "#d94a3d",
      "dark": "#ff746b"
    },
    "comparisonNegative": {
      "light": "#2b805a",
      "dark": "#61ca92"
    }
  },
  "shadow": {
    "card": {
      "light": "0 10px 28px rgba(38, 45, 58, .06)",
      "dark": "0 10px 28px rgba(0, 0, 0, .18)"
    },
    "hover": {
      "light": "0 14px 36px rgba(38, 45, 58, .10)",
      "dark": "0 14px 36px rgba(0, 0, 0, .24)"
    },
    "overlay": {
      "light": "0 24px 58px rgba(55, 68, 91, .16)",
      "dark": "0 24px 58px rgba(0, 0, 0, .32)"
    },
    "panel": {
      "light": "0 1px 2px rgba(31, 38, 50, .05), 0 10px 28px rgba(31, 38, 50, .075)",
      "dark": "0 1px 2px rgba(0, 0, 0, .20), 0 10px 26px rgba(0, 0, 0, .14)"
    }
  }
}
